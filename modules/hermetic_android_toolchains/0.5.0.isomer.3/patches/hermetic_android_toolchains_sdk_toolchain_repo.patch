+def _optional_java_import_names(api_level):
+    major = int(api_level.split(".")[0])
+    names = []
+    if major >= 23:
+        names.extend(["org_apache_http_legacy-{}".format(api_level), "org_apache_http_legacy"])
+    if major >= 28:
+        names.append("legacy_test-{}".format(api_level))
+    if major >= 29:
+        names.extend(["android_car-{}".format(api_level), "android_car"])
+    return names
+
+def _files_aliases(files_repository, api_level):
+    # Every target the files repository has that this one had before it was
+    # split off, under the same name: what rules_android and an app name.
+    names = [
+        ".sdk-root",
+        "platforms/android-{}/android.jar".format(api_level),
+        "platforms/android-{}/core-for-system-modules.jar".format(api_level),
+        "platforms/android-{}/framework.aidl".format(api_level),
+        "core-for-system-modules-jar",
+    ] + _optional_java_import_names(api_level)
+    return "\n\n".join([
+        _plain_alias(name, external_label(files_repository, name))
+        for name in names
+    ])
+
 def _platform_rules(sdk):
