+"""Generated Android SDK files repository.
+
+The SDK platform (android.jar and the rest) and the system images, what the
+toolchain repository (@%{toolchain_repository}) leaves out so that loading it
+downloads nothing. Fetched only when an Android build needs these files.
+"""
+
+load(":helper.bzl", "create_system_images_filegroups")
+load("@rules_java//java:defs.bzl", "java_import")
+
+package(default_visibility = ["//visibility:public"])
+
+exports_files([
+    ".sdk-root",
+    "platforms/android-%{api_level}/android.jar",
+    "platforms/android-%{api_level}/core-for-system-modules.jar",
+    "platforms/android-%{api_level}/framework.aidl",
+    "platforms/android-%{api_level}/source.properties",
+])
+
+%{optional_java_imports}
+
+java_import(
+    name = "core-for-system-modules-jar",
+    jars = ["platforms/android-%{api_level}/core-for-system-modules.jar"],
+)
+
+%{system_image_filegroups}
